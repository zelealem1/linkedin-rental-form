import os
import json
import logging
from datetime import datetime

from dotenv import load_dotenv

from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    WebAppInfo,
)

from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)


# ============================================================
# LOAD ENVIRONMENT VARIABLES
# ============================================================

load_dotenv()

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")

ADMIN_ID_TEXT = os.getenv("ADMIN_ID")
ADMIN_ID = int(ADMIN_ID_TEXT) if ADMIN_ID_TEXT else None

WEB_APP_URL = os.getenv(
    "WEB_APP_URL",
    "https://YOUR-GITHUB-USERNAME.github.io/linkedin-rental-form/"
)


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

logger = logging.getLogger(__name__)


# ============================================================
# TEMPORARY DATA STORAGE
# WARNING:
# DATA IS LOST WHEN THE BOT RESTARTS.
# DATABASE WILL BE ADDED LATER.
# ============================================================

offers = {}
next_offer_id = 1


# ============================================================
# PRICES
# ============================================================

PRICES = {
    "100": 5,
    "300": 7,
    "500": 13,
    "1000": 16,
    "2000": 20,
    "3000": 25,
}


# ============================================================
# HELPERS
# ============================================================

def is_admin(update: Update) -> bool:
    return (
        update.effective_user is not None
        and update.effective_user.id == ADMIN_ID
    )


def calculate_age_years(creation_date: str) -> float:
    created = datetime.strptime(
        creation_date,
        "%Y-%m-%d"
    )

    today = datetime.utcnow()

    days = (today - created).days

    return days / 365.25


def format_offer(offer_id, offer):
    return (
        f"Offer #{offer_id}\n"
        f"Status: {offer['status']}\n"
        f"Tier: {offer['tier']}+ connections\n"
        f"Weekly price: ${offer['weekly_price']}\n"
        f"Creation date: {offer['creation_date']}\n"
        f"Profile name: {offer['profile_name']}\n"
        f"Profile URL: {offer['profile_url']}\n"
        f"Payment method: {offer['payment_method']}\n"
        f"Payment account: {offer['payment_account']}\n"
        f"Owner name: {offer['owner_name']}\n"
        f"Supplier Telegram ID: {offer['supplier_id']}\n"
        f"Weeks: {offer.get('weeks', '-')}\n"
        f"Paid: {offer.get('paid', False)}"
    )


# ============================================================
# START COMMAND
# ============================================================

async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    keyboard = [
        [
            InlineKeyboardButton(
                "Submit LinkedIn Offer",
                web_app=WebAppInfo(url=WEB_APP_URL),
            )
        ]
    ]

    reply_markup = InlineKeyboardMarkup(keyboard)

    await update.message.reply_text(
        "Welcome!\n\n"
        "Use the button below to submit your LinkedIn account offer.",
        reply_markup=reply_markup,
    )


# ============================================================
# HELP COMMAND
# ============================================================

async def help_command(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if is_admin(update):
        await update.message.reply_text(
            "ADMIN COMMANDS\n\n"
            "/pending - View pending offers\n"
            "/accept <id> <weeks> - Accept an offer\n"
            "/pay <id> - Mark offer as paid\n"
            "/rented - View active rentals"
        )
    else:
        await update.message.reply_text(
            "Send /start to submit an offer."
        )


# ============================================================
# WEB APP DATA
# ============================================================

async def web_app_data(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    global next_offer_id

    if not update.message:
        return

    if not update.message.web_app_data:
        return

    try:
        data = json.loads(
            update.message.web_app_data.data
        )

    except (
        json.JSONDecodeError,
        TypeError,
    ):
        await update.message.reply_text(
            "Invalid submission data.\n\n"
            "Please reopen the form and try again."
        )
        return


    # --------------------------------------------------------
    # REQUIRED FIELDS
    # --------------------------------------------------------

    required_fields = [
        "tier",
        "creation_date",
        "profile_name",
        "profile_url",
        "payment_method",
        "payment_account",
        "owner_name",
    ]

    missing = [
        field
        for field in required_fields
        if not data.get(field)
    ]

    if missing:
        await update.message.reply_text(
            "Submission rejected.\n\n"
            "Missing required fields: "
            + ", ".join(missing)
        )
        return


    # --------------------------------------------------------
    # VALIDATE CREATION DATE
    # --------------------------------------------------------

    try:
        creation_date = datetime.strptime(
            data["creation_date"],
            "%Y-%m-%d",
        )

    except ValueError:
        await update.message.reply_text(
            "Invalid account creation date.\n\n"
            "Please use a valid date."
        )
        return


    if creation_date > datetime.utcnow():
        await update.message.reply_text(
            "Account creation date cannot be in the future."
        )
        return


    age_years = calculate_age_years(
        data["creation_date"]
    )

    if age_years < 1:
        await update.message.reply_text(
            "Submission rejected.\n\n"
            "The account must be at least 1 year old."
        )
        return


    # --------------------------------------------------------
    # VALIDATE TIER
    # --------------------------------------------------------

    tier = str(data["tier"])

    if tier not in PRICES:
        await update.message.reply_text(
            "Invalid connection tier."
        )
        return


    # --------------------------------------------------------
    # CREATE OFFER
    # --------------------------------------------------------

    offer_id = next_offer_id

    next_offer_id += 1

    offers[offer_id] = {
        "status": "pending",
        "tier": tier,
        "weekly_price": PRICES[tier],
        "creation_date": data["creation_date"],
        "profile_name": data["profile_name"],
        "profile_url": data["profile_url"],
        "payment_method": data["payment_method"],
        "payment_account": data["payment_account"],
        "owner_name": data["owner_name"],
        "supplier_id": update.effective_user.id,
        "weeks": None,
        "paid": False,
    }


    # --------------------------------------------------------
    # CONFIRM SUPPLIER
    # --------------------------------------------------------

    await update.message.reply_text(
        f"Submission received successfully!\n\n"
        f"Offer ID: #{offer_id}\n"
        f"Tier: {tier}+ connections\n"
        f"Weekly price: ${PRICES[tier]}\n"
        f"Status: Pending review."
    )


    # --------------------------------------------------------
    # NOTIFY ADMIN
    # --------------------------------------------------------

    try:
        await context.bot.send_message(
            chat_id=ADMIN_ID,
            text=(
                "NEW SUPPLIER OFFER\n\n"
                + format_offer(
                    offer_id,
                    offers[offer_id]
                )
            ),
        )

    except Exception:
        logger.exception(
            "Failed to notify admin."
        )


# ============================================================
# PENDING OFFERS
# ============================================================

async def pending(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not is_admin(update):
        return

    pending_offers = [
        (offer_id, offer)
        for offer_id, offer in offers.items()
        if offer["status"] == "pending"
    ]

    if not pending_offers:
        await update.message.reply_text(
            "There are no pending offers."
        )
        return

    text = "PENDING OFFERS\n\n"

    for offer_id, offer in pending_offers:
        text += format_offer(
            offer_id,
            offer
        )

        text += "\n\n--------------------\n\n"

    await update.message.reply_text(text)


# ============================================================
# ACCEPT OFFER
# /accept <id> <weeks>
# ============================================================

async def accept(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not is_admin(update):
        return

    if len(context.args) != 2:
        await update.message.reply_text(
            "Usage:\n\n"
            "/accept <offer_id> <weeks>\n\n"
            "Example:\n"
            "/accept 1 4"
        )
        return

    try:
        offer_id = int(
            context.args[0]
        )

        weeks = int(
            context.args[1]
        )

    except ValueError:
        await update.message.reply_text(
            "Offer ID and weeks must be numbers."
        )
        return


    if weeks <= 0:
        await update.message.reply_text(
            "Weeks must be greater than zero."
        )
        return


    if offer_id not in offers:
        await update.message.reply_text(
            "Offer not found."
        )
        return


    offer = offers[offer_id]

    if offer["status"] != "pending":
        await update.message.reply_text(
            f"Offer #{offer_id} is not pending."
        )
        return


    offer["status"] = "rented"

    offer["weeks"] = weeks

    offer["paid"] = False

    total = (
        offer["weekly_price"]
        * weeks
    )


    # --------------------------------------------------------
    # CONFIRM ADMIN
    # --------------------------------------------------------

    await update.message.reply_text(
        f"Offer #{offer_id} accepted!\n\n"
        f"Tier: {offer['tier']}+\n"
        f"Weekly rate: ${offer['weekly_price']}\n"
        f"Weeks: {weeks}\n"
        f"Total supplier payment: ${total}\n\n"
        f"Payment method: {offer['payment_method']}\n"
        f"Payment account: {offer['payment_account']}\n"
        f"Owner: {offer['owner_name']}"
    )


    # --------------------------------------------------------
    # NOTIFY SUPPLIER
    # --------------------------------------------------------

    try:
        await context.bot.send_message(
            chat_id=offer["supplier_id"],
            text=(
                f"Your offer #{offer_id} "
                f"has been accepted!\n\n"
                f"Rental period: {weeks} week(s)\n"
                f"Weekly payment: "
                f"${offer['weekly_price']}\n"
                f"Total: ${total}"
            ),
        )

    except Exception:
        logger.exception(
            "Failed to notify supplier."
        )


# ============================================================
# PAY OFFER
# /pay <id>
# ============================================================

async def pay(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not is_admin(update):
        return

    if len(context.args) != 1:
        await update.message.reply_text(
            "Usage:\n\n/pay <offer_id>"
        )
        return


    try:
        offer_id = int(
            context.args[0]
        )

    except ValueError:
        await update.message.reply_text(
            "Offer ID must be a number."
        )
        return


    if offer_id not in offers:
        await update.message.reply_text(
            "Offer not found."
        )
        return


    offer = offers[offer_id]

    if offer["status"] != "rented":
        await update.message.reply_text(
            "Only rented offers can be marked as paid."
        )
        return


    offer["paid"] = True

    offer["status"] = "paid"


    await update.message.reply_text(
        f"Offer #{offer_id} "
        f"marked as paid."
    )


    try:
        await context.bot.send_message(
            chat_id=offer["supplier_id"],
            text=(
                f"Payment for offer "
                f"#{offer_id} "
                f"has been marked as paid."
            ),
        )

    except Exception:
        logger.exception(
            "Failed to notify supplier."
        )


# ============================================================
# ACTIVE RENTALS
# ============================================================

async def rented(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not is_admin(update):
        return

    rented_offers = [
        (offer_id, offer)
        for offer_id, offer in offers.items()
        if offer["status"] == "rented"
    ]

    if not rented_offers:
        await update.message.reply_text(
            "There are no active rentals."
        )
        return


    text = "ACTIVE RENTALS\n\n"

    for offer_id, offer in rented_offers:

        total = (
            offer["weekly_price"]
            * offer["weeks"]
        )

        text += (
            f"Offer #{offer_id}\n"
            f"Tier: {offer['tier']}+\n"
            f"Weeks: {offer['weeks']}\n"
            f"Weekly: ${offer['weekly_price']}\n"
            f"Total: ${total}\n"
            f"Paid: "
            f"{'Yes' if offer['paid'] else 'No'}\n"
            f"Profile: {offer['profile_name']}\n\n"
        )

    await update.message.reply_text(text)


# ============================================================
# MAIN
# ============================================================

def main():

    if not TOKEN:
        raise RuntimeError(
            "TELEGRAM_BOT_TOKEN is not configured."
        )

    if not ADMIN_ID:
        raise RuntimeError(
            "ADMIN_ID is not configured."
        )


    application = (
        Application.builder()
        .token(TOKEN)
        .build()
    )


    # --------------------------------------------------------
    # COMMAND HANDLERS
    # --------------------------------------------------------

    application.add_handler(
        CommandHandler("start", start)
    )

    application.add_handler(
        CommandHandler(
            "help",
            help_command
        )
    )

    application.add_handler(
        CommandHandler(
            "pending",
            pending
        )
    )

    application.add_handler(
        CommandHandler(
            "accept",
            accept
        )
    )

    application.add_handler(
        CommandHandler(
            "pay",
            pay
        )
    )

    application.add_handler(
        CommandHandler(
            "rented",
            rented
        )
    )


    # --------------------------------------------------------
    # WEB APP HANDLER
    # --------------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.StatusUpdate.WEB_APP_DATA,
            web_app_data,
        )
    )


    logger.info("Bot starting...")

    application.run_polling()


# ============================================================
# RUN BOT
# ============================================================

if __name__ == "__main__":
    main()
